{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "assert-mode ties: signed sums of field paths",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["name", "left", "right"],
    "properties": {
      "name": {"type": "string", "minLength": 1},
      "left": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "right": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "tolerance": {"type": "number", "exclusiveMinimum": 0}
    }
  }
}
