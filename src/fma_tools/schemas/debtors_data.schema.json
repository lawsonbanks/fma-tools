{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Debtors pack tie data",
  "type": "object",
  "required": ["dates"],
  "properties": {
    "dates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["as_at", "detail_source", "agent_bands", "summary_total",
                     "ar_control_bs"],
        "properties": {
          "as_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "detail_source": {"type": "string", "minLength": 1},
          "agent_bands": {"$ref": "#/$defs/bands"},
          "summary_total": {"type": "number"},
          "summary_bands": {"$ref": "#/$defs/bands"},
          "ar_control_bs": {"type": "number"}
        }
      }
    },
    "control_ledger": {
      "type": "object",
      "required": ["from", "to", "opening", "closing"],
      "properties": {
        "from": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "to": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "opening": {"type": "number"},
        "closing": {"type": "number"}
      }
    },
    "disclosed_differences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "amount", "note"],
        "properties": {
          "check": {"type": "string", "minLength": 1},
          "amount": {"type": "number"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "bands": {
      "type": "object",
      "required": ["current", "lt1", "m1", "m2", "m3", "older"],
      "additionalProperties": false,
      "properties": {
        "current": {"type": "number"},
        "lt1": {"type": "number"},
        "m1": {"type": "number"},
        "m2": {"type": "number"},
        "m3": {"type": "number"},
        "older": {"type": "number"}
      }
    }
  }
}
