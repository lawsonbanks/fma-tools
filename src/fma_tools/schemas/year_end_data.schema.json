{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Year-end room pack tie data",
  "type": "object",
  "required": ["as_at", "ar", "prior_year_pnl", "cash", "ageing_bands"],
  "properties": {
    "as_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "ar": {
      "type": "object",
      "required": ["detail_total", "summary_total", "bs_line"],
      "properties": {
        "detail_total": {"type": "number"},
        "summary_total": {"type": "number"},
        "bs_line": {"type": "number"}
      }
    },
    "prior_year_pnl": {
      "type": "object",
      "required": ["basis", "lodged_basis", "lines"],
      "properties": {
        "basis": {"enum": ["pre_tax", "post_tax"]},
        "lodged_basis": {"enum": ["pre_tax", "post_tax"]},
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "ours", "lodged"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "ours": {"type": "number"},
              "lodged": {"type": "number"}
            }
          }
        }
      }
    },
    "cash": {
      "type": "object",
      "required": ["opening_bank", "closing_bank", "movement_stated"],
      "properties": {
        "opening_bank": {"type": "number"},
        "closing_bank": {"type": "number"},
        "movement_stated": {"type": "number"}
      }
    },
    "ageing_bands": {
      "type": "object",
      "required": ["current", "lt1", "m1", "m2", "m3", "older", "total"],
      "additionalProperties": false,
      "properties": {
        "current": {"type": "number"},
        "lt1": {"type": "number"},
        "m1": {"type": "number"},
        "m2": {"type": "number"},
        "m3": {"type": "number"},
        "older": {"type": "number"},
        "total": {"type": "number"}
      }
    },
    "disclosed_differences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "amount", "note"],
        "properties": {
          "check": {"type": "string", "minLength": 1},
          "amount": {"type": "number"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
